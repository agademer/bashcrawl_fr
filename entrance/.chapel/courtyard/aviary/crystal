ITEM=cristal

if ! grep --quiet "$ITEM" <<<"$I" ; then
    cat << EOF
Un cristal blanc, forgé par la Reine de l'Hiver, sur le
sol gelé.

Vous pouvez ajouter cet objet à votre inventaire :

I=$ITEM,\$I

N'oubliez pas que vous pouvez vérifier votre inventaire :

echo \$I

EOF
else
    echo "Le cristal a déjà été pris."
fi
