#import global functions from toplevel directory
FUNCTIONS=$(pwd)
FUNCTIONS=${FUNCTIONS%entrance*}entrance/.functions
. $FUNCTIONS

roll() {
    printf "Entrez un nombre:  "
    read NUM
    ALPHA=$RANDOM
    OMEGA=$RANDOM
    A=`echo $ALPHA | cut -b 1-2`
    O=`echo $OMEGA | cut -b 1-2`
    let "NUM=$ALPHA % $OMEGA"
    MONSTER=$RANDOM
    MONSTER=`echo $MONSTER | cut -b 1-2`
    NUM=`echo $NUM | cut -b 1-2`
    echo "Le monstre a lancé " $MONSTER
    echo "Vous avez lancé " $NUM
    resolve
}

resolve() {
    if ! grep  --quiet --only-matching 'épée' <<< $I; then
        cat << EOF
Vous n'avez pas d'épée !

Vos attaques seront moins efficaces.

EOF
        let NUM=NUM-10
    fi
    if [[ $MONSTER -eq $NUM ]]; then
        cat << EOF
Vous parez mutuellement vos attaques.  Relancez les dés...

EOF
	roll
    fi

    if [[ $MONSTER -lt $NUM ]]; then
        cat << EOF
Touché ! Un coup critique !  Vous avez terrassé la bête.

EOF
        cat << EOF > treasure
#!/usr/bin/env bash
if ! grep  --quiet --only-matching couronne <<< \$I; then
    cat << eof
Vous avez trouvé une **couronne** !  Ajoutez-la à votre inventaire.

eof

else
    echo "Ce trésor a déjà été pris."
fi

EOF
        chmod +x treasure
        mv monster carcass
    else
        cat << EOF

Votre attaque est déviée par la peau coriace du monstre.
Vous subissez 5 points de dégâts. Déduisez-les de vos HP.

let HP=HP-5

EOF
        let HP=HP-5
        export HP
        if [ "$HP" -le 0 ]; then
            cat << EOF
Vous avez été tué par le monstre.

FIN DE LA PARTIE !

EOF
            gameover
            exit 1
        fi
	roll
    fi
}

if [ "$0" = "./carcass" ]; then
    cat << EOF
Vous trouvez la carcasse d'une bête répugnante.  Rien d'intéressant
ne se trouve parmi ses restes.

EOF
    exit 0
fi

cat << EOF
Une bête imposante à trois pattes, avec une gueule pleine de crocs,
une queue barbelée et huit bras, s'avance lourdement vers vous.

Si vous avez une épée, vous pouvez attaquer.  Sinon, vous devriez
fuir.

EOF
printf "Voulez-vous attaquer ? o/n  "
read RESP

if [ "$RESP" = "o" -o "$RESP" = "O" ];then
    roll
else
    cat << EOF
Vous faites preuve de sagesse en faisant demi-tour et en prenant la fuite.  
Faites rapidement un cd vers le répertoire précédent.

EOF
fi
