gameover () {
    cat << EOF > corpse
Vous voyez le cadavre d'un aventurier tué sur le sol du
donjon.  Vous trouvez les objets suivants sur le cadavre :

${I}

EOF
    curr=`basename $PWD`
    while [ "$curr" != "entrance" ]; do
        pushd .. &> /dev/null
        dirs -c
        curr=`basename $PWD`
    done
    unset I
    unset HP
    $SHELL
}

penguin_bite () {
    cat << EOF
Le pingouin ronge votre sac de transport, dans l'espoir d'y trouver quelque chose à manger.
Ne trouvant rien, il vous mord la main, vous infligeant 1 point de dégâts (let "HP=HP-1"). 
Vous pouvez éviter ces dégâts si vous avez une épée et que vous souhaitez attaquer le pingouin.

EOF
printf "Voulez-vous attaquer le pingouin ? o/n  "
	read RESP
	if [ "$RESP" = "o" -o "$RESP" = "O" ]; then
        cat << EOF
Vous attaquez le pingouin et le terrez rapidement d'un
coup rapide. Cela attire l'attention des autres pingouins
présents dans la pièce. Ils se regroupent et se précipitent sur vous. Vous vous battez
de toutes vos forces.

EOF
        let HP=HP-5
        export HP
        if [ "$HP" -le 0 ]; then
            cat << EOF
La meute de pingouins réduit vos points de vie à zéro.  Vous
êtes tué par la meute.

EOF
            gameover
            exit 1
        else
            cat << EOF
Mais une foule de pingouins ne tolère pas l'oppression, et vous
vous retrouvez rapidement emprisonné dans un bloc de glace.  Vous y restez,
parfaitement conservé pendant 128 ans. Une fois dégelé, vous
pouvez poursuivre votre aventure.

EOF
        fi
	else
        let HP=HP--
        export HP
	    echo "Vous gardez la tête froide et ne vous en prenez pas au pingouin."
	fi
}

cat << EOF
L'un des oiseaux finit par remarquer votre présence.  Il tourne
la tête sur le côté, comme pour vous inviter à vous
approcher.

EOF
printf "Vous vous rapprochez ? o/n  "
read RESP

if [ "$RESP" = "o" -o "$RESP" = "O" ]; then
    cat << EOF
Vous faites un pas en avant, et l'oiseau se précipite vers vous, la
gueule grande ouverte.

EOF
    printf "Avez-vous un poisson ? o/n  "
    read RESP

    if [ "$RESP" = "o" -o "$RESP" = "O" ]; then
        if grep  --quiet --only-matching poisson <<< $I; then
            cat << EOF

Vous lancez le poisson au pingouin,  qui l'attrape
en plein vol et l'avale goulûment.

N'oubliez pas de retirer le poisson de votre inventaire.  Essayez
la commande suivante :

export I=\$(sed "s/poisson//; s/,,/,/" <<< \$I)

EOF
        else
            echo "Vous n'avez pas de poisson !"
            echo
            penguin_bite
        fi
   else
        penguin_bite
   fi
else
    cat << EOF
Vous vous éloignez prudemment du pingouin.  Il se désintéresse
de vous et s'éloigne en se dandinant.

EOF

fi
