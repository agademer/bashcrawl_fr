ITEMS=("haillons" "poisson")

if ! grep --quiet "${ITEMS[0]}" <<< "$I" ; then
    cat << EOF
Il y a un tas de vieux **haillons**.  Ils sont vieux et usés par le
temps, et appartenait probablement à un pauvre aventurier.

EOF
    printf "Voulez-vous ramassez les haillons ? o/n  "

    read RESP

    if [ "$RESP" = "o" -o "$RESP" = "O" ];then
        cat << EOF
En ramassant les haillons sur le sol, vous trouvez un poisson salé,
probablement issu des rations de l'ancien propriétaire de ces haillons.
Ajoutez ces objets à votre inventaire :

export I=$(IFS=, ; echo "${ITEMS[*]}"),\$I

N'oubliez pas que vous pouvez vérifier votre inventaire.

echo \$I

EOF
    fi
else
    echo "Les haillons ont déjà été pris."
fi
