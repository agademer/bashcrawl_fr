damage() {
    cat << EOF
Vous essayez de résister, mais vous n'y parvenez pas.  Vous plongez votre main dans
la fontaine  et vous sentez votre peau brûler.  La douleur
vous tire de votre transe et vous ne subissez que -2 PV.

N'oubliez pas de déduire 2 points de votre variable PV :

let "HP=HP-2"

EOF

}

CURSE=`find .. -type f -name ".curse"`

printf "Voulez-vous vous approcher de la fontaine ? o/n  "
read RESP

if [ "$RESP" = "o" -o "$RESP" = "O" ]; then
    cat << EOF
Les eaux scintillent à la lumière de votre regard.  Vous vous sentez
attiré par elles.

EOF
    if [ x$CURSE = "x" ]; then
        cat << EOF
Mais vous vous sentez soudain la force de détourner le regard.  Vous entendez un
soupir provenant de l'autel de la chapelle.

EOF
   else
       damage
   fi
else
    if [ ! -z "$CURSE" ]; then
	damage
    fi
fi

[ -f ../.curse ] && rm ../.curse
