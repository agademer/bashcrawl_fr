# lisez ce code et voyez si vous pouvez comprendre ce qu'il fait.
#
# Lorsque vous serez prêt à continuer à jouer, concentrez-vous sur
# les parchemins. Si vous êtes bloqué, rendez-vous sur Gitlab et créez un ticket.
# Nous serons ravis de vous donner des indices.
#

ITEM=bijou

function askPutBackOnAltar() {
    echo "Voulez-vous remettre le bijou sur l'autel ? o/n  "
    read RESP
    return $([ "$RESP" = "o" -o "$RESP" = "O" ])
}

function askPutInInventory() {
    echo "Voulez-vous garder le bijou pour vous ? o/n  "
    read RESP
    return $([ "$RESP" = "o" -o "$RESP" = "O" ])
}

function askPutBackOnGround() {
    echo "Voulez-vous remettre le bijou par terre ?"
    echo "o/n  "
    read RESP
    return $([ "$RESP" = "o" -o "$RESP" = "O" ])
}

function putOnAltar() {
    cat << EOF
Vous placez le bijou sur l'autel.  Vous sentez une douce
brise traverser la pièce.

EOF
    touch .bless
}

function putInInventory() {
    echo "N'oubliez pas d'ajouter le 'bijou' à votre inventaire !"
    echo ""
    touch .curse
}

function leaveOnGround() {
    cat << EOF
Vous laissez le bibelot là où il se trouve.  Il y a une grande
tristesse ici.  Vous vous sentez obligé de passer votre chemin.

EOF
    touch .curse
}

function remindRemoveInventory() {
    cat << EOF
N'oubliez pas de retirer le bijou de votre inventaire.  Essayez
la commande suivante :

export I=$(sed "s/$ITEM,//" <<< "$I")
EOF
}

echo "Dans le coin se trouve un vieil autel en ruine dédié à un dieu oublié."

if grep --quiet "$ITEM" <<< "$I" ; then
    if askPutBackOnAltar ; then
        putOnAltar
        remindRemoveInventory
        rm -f .curse
    elif askPutBackOnGround ; then
        leaveOnGround
        remindRemoveInventory
    else
        echo -e "Vous conservez le bijou dans votre inventaire.\n"
    fi
elif [ -f .bless ]; then
    if askPutInInventory ; then
        putInInventory
        rm .bless
    elif askPutBackOnGround ; then
        leaveOnGround
        rm .bless
    else
        echo -e "Vous laissez le bijou sur l'autel.\n"
    fi
elif [ -f .curse ]; then
    if askPutBackOnAltar ; then
        putOnAltar
        rm .curse
    elif askPutInInventory ; then
        putInInventory
    else
        leaveOnGround
    fi
else
    cat << EOF
Il y a un petit bijou par terre.  Il semble être de nature religieuse.

EOF
    if askPutBackOnAltar ; then
        putOnAltar
    elif askPutInInventory ; then
        putInInventory
    else
        leaveOnGround
    fi
fi














































































































































































































































































