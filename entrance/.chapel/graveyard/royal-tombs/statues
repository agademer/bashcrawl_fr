#import global functions from toplevel directory
FUNCTIONS=$(pwd)
FUNCTIONS=${FUNCTIONS%entrance*}entrance/.functions
. $FUNCTIONS

# this runs after the statue has been "destroyed"
# and this file has been renamed to 'pieces'
if [ "$0" = "./king" ]; then
    cat << EOF
Vous avez déjà dévoilé le numéro secret.

Mémorisez-le en l'ajoutant à votre inventaire :

export I=7432,\$I
EOF
    exit 1
fi

# start the statue encounter
cat << EOF
Debout devant les statues, vous réfléchissez aux symboles
sur le cadenas. Avez-vous un objet dans votre inventaire qui vous semble familier ?

EOF
printf "Avez-vous cet objet ? o/n  "

read RESP

if [ "$RESP" = "o" -o "$RESP" = "O" ]; then
    if grep  --quiet --only-matching couronne <<< $I; then
        cat << EOF

Vous tenez la couronne entre vos mains, réfléchissant à l'endroit où la placer.

EOF
        printf "Entrez le numéro de la statue sur laquelle vous souhaitez placer la couronne :  "

        read RESP

        if [ "${RESP:0:1}" -eq "5" -o "${RESP:0:2}" -eq "05" ]; then
            cat << EOF

Vous tombez sur une tombe isolée surmontée d'une imposante statue représentant un roi,
dont la silhouette autrefois majestueuse est aujourd'hui usée et érodée. La couronne
qui ornait autrefois sa tête a disparu. Des vignes grimpent sur le socle de la statue,
s'enroulant autour des pieds du roi.

Alors que vous posez délicatement la couronne sur la tête de la statue, un grondement sourd
résonne à travers le sol, et les yeux du roi de pierre s'ouvrent lentement,
brillant d'une lumière éthérée. La statue bouge, levant son bras
pour révéler une gravure cachée sur le socle : un nombre secret, **7432**,
gravé dans une écriture ancienne. Il brille faiblement d'une lueur dorée, et le roi vous fait un signe de tête
solennel avant de retourner à l'immobilité.

Retirez la couronne de votre inventaire :

export I=\$(sed 's/crown,//' <<< \$I)

Mémorisez le numéro en l'ajoutant à votre inventaire :

export I=7432,\$I

EOF
            mv statues king
        else
            cat << EOF

La pierre tombale érodée est flanquée de piliers recouverts de lierre, tandis qu'une
majestueuse statue de marbre trône au sommet. La statue, représentant une figure sereine
en tenue royale avec une couronne inclinée, regarde solennellement au loin. Autour
de la base, des lanternes brisées et des urnes fissurées témoignent de la grandeur passée,
leur silence seulement interrompu par le bruissement des feuilles et les cris lointains
des corbeaux.

Alors que vous ajustez la couronne sur la tête de la statue, celle-ci glisse de son
perchoir précaire et tombe au sol dans un bruit métallique.
À cet instant, une lueur sombre et magique s'échappe de la statue,
vous enveloppant d'un froid inquiétant.

EOF
            let HP=HP-5
            export HP
            if [ "$HP" -le 0 ]; then
                cat << EOF
Une vague de malaise vous envahit, et un poids énorme semble s'installer dans
votre poitrine. Vous êtes terrassé par la magie.

EOF
                gameover
                exit 1
            else
                cat << EOF
La magie vous laisse désorienté et mal à l'aise, comme si les ombres
du passé avaient momentanément obscurci votre esprit et sapé vos forces.

Déduisez 5 de votre variable HP :

let "HP=HP-5"

EOF
            fi

        fi
    else
        echo "Vous ne l'avez pas ! Continuez à chercher."
        echo
        exit
    fi

else
    cat << EOF
Vous vous éloignez des statues et poursuivez votre recherche de l'objet.
EOF

fi













































































































































































































































































































