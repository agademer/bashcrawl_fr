# les parchemins. Si vous êtes bloqué, rendez-vous sur Gitlab et créez un ticket.
# Nous serons ravis de vous donner des indices.
#
if [[ -e orb1 && -e orb2 && -e orb3 ]]; then
    cat << EOF
Vous avez libéré la forme matérielle du gobelet.  Ajoutez 'gobelet' à
votre inventaire.

EOF
    exit
else 
    cat << EOF
Vous essayez d'attraper le gobelet qui brille faiblement, mais il passe
à travers vos doigts.

EOF

fi

printf "Vous êtes bloqué ? Vous avez besoin d'un indice ? o/n  "
read RESP

if [ "$RESP" = "o" -o "$RESP" = "O" ]; then
    cat << EOF
Essayez de rechercher sur opensource.com des conseils sur la manière de copier des fichiers.

EOF
    printf "Vous êtes toujours bloqué ? Avez-vous besoin de la réponse ? o/n  "
    read RESP

    if [ "$RESP" = "o" -o "$RESP" = "N" ]; then
        cat << EOF
Vous êtes toujours bloqué ? Vous avez besoin de la commande cp pour copier un fichier vers un autre. Exécutez ces
commandes :

cp orb1 orb2
cp orb1 orb3

Puis relancez le script goblet pour confirmation. 

EOF
    fi
fi


















































































































































































































































































