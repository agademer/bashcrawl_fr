#!/bin/bash
#
# Si vous lisez ceci, c'est que vous avez dépassé les limites
# et que vous lisez le code qui pilote le jeu.
#
#                    Félicitations !
#
# Apprendre Linux, c'est avant tout une question de curiosité, alors 
# lisez ce code et voyez si vous pouvez comprendre ce qu'il fait.
#
# Lorsque vous serez prêt à continuer à jouer, concentrez-vous sur
# les parchemins. Si vous êtes bloqué, rendez-vous sur Gitlab et créez un ticket.
# Nous serons ravis de vous donner des indices.
#

gameover () {
    cat << EOF > corpse
Vous voyez le cadavre d'un aventurier tué sur le sol du
donjon.  Vous trouvez les objets suivants sur le cadavre :

$I

EOF
    curr=`basename $PWD`
    while [ "$curr" != "entrance" ]; do
        pushd .. &> /dev/null
        dirs -c
        curr=`basename $PWD`
    done
    unset I
    unset HP
    $SHELL
}

# this runs after the statue has been "destroyed"
# and this file has been renamed to 'pieces'
if [ "$0" = "./pieces" ]; then
    cat << EOF
Vous passez au crible les morceaux d'une statue brisée.

Vous ne trouvez rien d'intéressant dans les restes de la statue.

EOF
    exit 1
fi

# start the statue encounter
cat << EOF
Une statue amochée se dresse dans un coin de la pièce.

EOF
printf "Vous vous en approchez ? o/n  "

read RESP

if [ "$RESP" = "o" -o "$RESP" = "O" ]; then
    cat << EOF
La statue prend vie en grondant :

QUI OSE S'INTRODUIRE DANS LA CHAMBRE DES ESPRITS ?

Elle vous frappe d'un coup de poing, vous infligeant 5 points de dégâts.

EOF

    # this does not change the user's HP,
    # it only calculates it after damage
    let "HP=HP-5"
    if [ "$HP" -le 0 ]; then
        cat << EOF
Vous avez été tué par la statue.

FIN DE LA PARTIE !

EOF
        gameover
        exit 1
    fi

    perl -pe 's/coins/diamonds/' -i ./treasure
    printf "Avez-vous une épée ? o/n  "
    read RESP
    if [ "$RESP" = "o" -o "$RESP" = "O" ]; then
       if grep  --quiet --only-matching 'épée' <<< $I; then
           cat <<EOF
Vous frappez la statue et elle se brise en morceaux !

Cependant, vous avez subi des dégâts.
Déduisez 5 de votre variable HP :

let "HP=HP-5"

EOF
           mv statue pieces
       else
           cat << EOF
Non, vous n'en avez pas ! Cours !
Vous avez subi des dégâts infligés par la statue animée.
Déduis 5 points de ta variable HP :

let "HP=HP-5"

EOF
           rm treasure
           rm spell
      fi
    else
        cat <<EOF
Cours !
Vous avez subi des dégâts infligés par la statue animée.
Déduis 5 points de ta variable HP :

let "HP=HP-5"

EOF
   fi
else
    cat << EOF
Vous évitez prudemment la statue, vous rappelant les histoires de statues animées
qui guettent, au fond des catacombes hantées.

EOF

fi













































































































































































































































































































