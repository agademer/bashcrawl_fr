echo
if ! grep  --quiet --only-matching pièces <<< $I; then
    cat << EOF
Vous avez trouvé une cachette remplie de **pièces** !  Elles sont vieilles et usées
par le temps,  mais elles brillent toujours de la lumière magique
qui émane de vos yeux.

Ajoutez cet objet à votre inventaire :

export I=pièces,\$I

N'oubliez pas que vous pouvez vérifier votre inventaire :

echo \$I

EOF
else
    echo "Ce trésor a déjà été pris."
    echo
fi








































































































































































































































































































































