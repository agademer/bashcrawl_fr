# check if we found that bottle already ...
if [[ -v HP ]] ; then
  cat <<EOF
Vous avez déjà vérifié cette bouteille. 
EOF
else
# let's investigate the bottle...
cat << EOF
Vous avez trouvé une fiole contenant un liquide vert tourbillonnant.
Voulez-vous la boire ?  o/n

EOF
read RESP

if [ "$RESP" = "o" -o "$RESP" = "O" ]; then
   cat << EOF
Le goût d'une plante verte rustique emplit votre bouche.  Il
vous réchauffe et vous fortifie.

Créez une variable pour vos points de vie (HP).  Vous avez
15 HP :

export HP=15

EOF
else
    cat << EOF
Vous n'êtes pas né de la dernière pluie. Cette potion est probablement
du poison.

Crée une variable pour tes points de vie (HP).  Vous avez
10 HP :

export HP=10

EOF

fi

cat << EOF
Vous pouvez vérifier votre état de santé à tout moment :

echo \$HP

EOF
mv ../../.chapel ../../chapel 2>/dev/null
mv ../../.vault ../../vault 2>/dev/null
mv ../../.scrap ../../scrap 2>/dev/null
fi



















































































































































































































































































