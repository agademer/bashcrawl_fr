#!/bin/bash
#
# Si vous lisez ceci, c'est que vous avez dépassé les limites
# et que vous lisez le code qui pilote le jeu.
#
#                    Félicitations !
#
# Apprendre Linux, c'est avant tout une question de curiosité, alors 
# lisez ce code et voyez si vous pouvez comprendre ce qu'il fait.
#
# Lorsque vous serez prêt à continuer à jouer, concentrez-vous sur
# les parchemins. Si vous êtes bloqué, rendez-vous sur Gitlab et créez un ticket.
# Nous serons ravis de vous donner des indices.
#
cat << EOF
Une boîte métallique repose sur le sol.  Elle semble être
éclairée de l'intérieur.  Il y a une ouverture dans la boîte. L'ouverture
est noire, mais elle comporte une inscription luminescente.

EOF
printf "Voulez-vous lire ce qui est écrit ? o/n  "
read RESP

if [ "$RESP" = "o" -o "$RESP" = "O" ]; then
    cat << EOF

.------------------------------------,
|       Bienvenue dans POSIX         |
|   Entrez votre nom d'utilisateur : |
'------------------------------------'
EOF
   read RESP

   if [ "$RESP" = "$USER" ]; then
       cat << EOF > armour
#!/bin/bash
cat << eof
Bienvenue, ${USER}, dans votre système POSIX.  Vous avez beaucoup appris,
et vous disposez désormais des connaissances de base nécessaires pour devenir un
sorcier vraiment puissant.

Vous avez trouvé une armure magique.  Ajoutez-la à votre inventaire.

eof
touch .armour
touch .bless

EOF
        chmod +x armour
        echo "Vous sentez la magie dans l'air."
   fi
else
    cat << EOF
La boîte est pleine de mystère, et il vaut souvent mieux ne pas chercher
à trop approfondir les énigmes.

EOF
fi


















































































































































































































































































