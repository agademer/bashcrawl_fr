floors=666
countdown () {
	var=${floors}
	len=${#var}
	echo -n $var
    let m=var-1
	for t in `seq ${m} -1 1`
	do
		sleep 0.1
		for i in `seq ${len} -1 1`
		do
			echo -ne '\b'
		done
		if [ $len -gt ${#t} ]
		then
            let l=len-1
			for n in `seq ${l} -1 ${#t}`
			do
				echo -n '0'
			done
		fi
		echo -n $t
	done
}


countup () {
	var=${floors}
	for t in `seq 1 ${var}`
	do
		sleep 0.1
        len=${#t}
		for i in `seq 1 ${#var}`
		do
			echo -ne '\b'
		done
        if [ ${len} -lt ${#var} ]; then
            let n=${#var}-len
            for j in `seq 1 ${n}`
            do
                echo -ne '0'
            done
        fi
        echo -n $t
	done
}

if grep --quiet UP .direction; then
    cat << EOF
Vous entendez un léger vrombissement et ressentez une lourdeur au niveau des
pieds, accompagnée d'une vague et inquiétante sensation de mouvement.

Une inscription magique indique :

EOF
    countup
    cat << EOF

Les portes coulissent pour s'ouvrir, ne laissant apparaître que l'obscurité.

EOF
    echo "DOWN" > .direction
    ln -sf .satellite door && \
        sleep 10 && \
        echo "Les portes se ferment en coulissant." && \
        rm door &> /dev/null && \
    echo "DOWN" > .direction &
    echo
else
    cat << EOF
Vous entendez un léger vrombissement et ressentez une légèreté au niveau de vos
pieds, accompagnée d'une vague et inquiétante sensation de mouvement.

Une inscription magique indique :

EOF
    countdown
    echo
    echo
    echo "UP" > .direction &
    cat << EOF
Les portes coulissent pour s'ouvrir, ne laissant apparaître que l'obscurité.

EOF
    ln -sf .. door && \
        sleep 10 && \
        echo "Les portes se ferment en coulissant." && \
        rm door &> /dev/null &
    echo
fi
