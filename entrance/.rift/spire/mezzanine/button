cat << EOF
Vous voyez un bouton rouge lumineux avec ce qui semble être une
flèche pointant vers le haut inscrite sur sa face.

EOF
printf "Êtes-vous tenté d'appuyer sur le bouton ?  o/n  "
read RESP

if [ "$RESP" = "o" -o "$RESP" = "O" ]; then
    echo "Les portes coulissantes s'ouvrent, révélant une petite pièce."
    echo "UP" > .elevator/.direction
    ln -sf .elevator door &> /dev/null && \
        sleep 10 && \
        echo "Les portes se ferment en coulissant.." && \
        unlink door &
    echo
fi
