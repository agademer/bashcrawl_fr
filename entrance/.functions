#
# Si vous lisez ceci, c'est que vous avez dépassé les limites
# et que vous lisez le code qui pilote le jeu.
#
#                    Félicitations !
#
# Apprendre Linux, c'est avant tout une question de curiosité, alors lisez ce code et voyez
# si vous pouvez comprendre ce qu'il fait.
#
# Lorsque vous serez prêt à continuer à jouer, cependant, tenez-vous en aux
# parchemins. Si vous êtes bloqué, rendez-vous sur Gitlab et créez un ticket.
# Nous serons ravis de vous donner des indices.
# 
# Il s'agit d'une fonction personnalisée.
# Une fonction est un extrait de code que vous pouvez utiliser dans d'autres fichiers.
# Chaque fois que vous voyez la commande « gameover » dans un fichier de ce
# donjon, il s'agit d'un « appel » à cette fonction.

gameover () {
    CORPSE=$(mktemp corpse.XXX)
    cat << EOF2 > $CORPSE
#!/usr/bin/env bash
#
# Si vous lisez ceci, c'est que vous avez dépassé les limites
# et que vous êtes en train de lire le code qui pilote le jeu.
#
#                    Félicitations !
#
# Apprendre Linux, c'est avant tout une question de curiosité, alors lisez ce code et voyez
# si vous pouvez comprendre ce qu'il fait.
#
# Lorsque vous serez prêt à continuer à jouer, concentrez-vous sur
# les parchemins. Si vous êtes bloqué, rendez-vous sur Gitlab et créez un ticket.
# Nous serons ravis de vous donner des indices.
# 

CORPSE=\$(basename \$0)

echo
if [ ! -e .\$CORPSE.looted ]; then
    cat << EOF
Vous voyez le cadavre d'un aventurier tué sur le sol du
donjon.  Vous trouvez les objets suivants sur le cadavre :  

${I}

EOF

    touch .\$CORPSE.looted
else
    echo "Ce cadavre a déjà été pillé."
    echo
fi
EOF2

    for i in {0..327}; do
        echo >>$CORPSE
    done

    cat << EOF2 >> $CORPSE
# Hmm, ça n'a pas marché.
# N'oubliez pas que lorsque les fichiers se terminent par un * 
#, cela signifie qu'il s'agit d'applications.
# Essayez ceci :
#
# ./$CORPSE


EOF2
    chmod +x $CORPSE

    curr=`basename $PWD`
    while [ "$curr" != "entrance" ]; do
        pushd .. &> /dev/null
        dirs -c
        curr=`basename $PWD`
    done
    unset I
    unset HP
    $SHELL
}
